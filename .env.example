# === Slack tokens ===
SLACK_BOT_TOKEN=xoxb-your-bot-token

# --- Pick ONE mode: ---

# OPTION A: Socket Mode (no public URL, requires @mention in channels)
SLACK_APP_TOKEN=xapp-your-app-level-token

# OPTION B: Events API (Cloudflare tunnel, no @mention needed)
# Uncomment the line below and comment out SLACK_APP_TOKEN above:
# SLACK_SIGNING_SECRET=your-signing-secret

# === Bot config ===

# Optional: comma-separated Slack user IDs to restrict access
# Leave empty = all workspace users allowed
AUTHORIZED_USERS=

# Working directory — where `claude -p` runs from. Claude can read/write files here.
PROJECT_DIR=~/claude-workspace

# Claude CLI settings (hot-reloadable — edit .env while bot is running)
CLAUDE_TIMEOUT=1800
CLAUDE_MODEL=
CLAUDE_EFFORT=high
CLAUDE_PERMISSION_MODE=bypassPermissions

# Show Claude's tool calls in Slack (reading files, running commands, etc.)
MIRROR_TOOLS_TO_SLACK=true

# Continue the same Claude session if you @mention the bot again within this
# many seconds in the same channel (even without replying in-thread).
SESSION_RECENT_WINDOW=600

# Port for Events API mode only (ignored in Socket Mode)
PORT=3456
